{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "North Drive Downloader",
  "version": "1.0.0",
  "identifier": "com.northdrive.downloader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "North Drive Downloader",
        "width": 1480,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 690,
        "center": true,
        "backgroundColor": "#090911",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 170,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 220
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
